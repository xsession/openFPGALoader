#!/bin/bash
set -e

case "$1" in
    remove|purge)
        for rule in 70-openfpgaloader.rules 99-openfpgaloader.rules; do
            path="/etc/udev/rules.d/$rule"
            target="/usr/lib/udev/rules.d/$rule"
            if [ -L "$path" ] && [ "$(readlink "$path")" = "$target" ]; then
                rm -f "$path"
            fi
        done
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules 2>/dev/null || true
        fi
        ;;
esac
exit 0
