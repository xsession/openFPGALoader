# The cross-build image only needs its Dockerfile/toolchain plus the optional
# prebuilt XPCU archive. The complete project is bind-mounted at runtime.
**
!deploy/
!deploy/docker/
!deploy/docker/cross/
!deploy/docker/cross/windows/
!deploy/docker/cross/windows/alpine.Dockerfile
!deploy/docker/cross/windows/toolchain-mingw64.cmake
!externals/
!externals/xilinx-usb-driver/
!externals/xilinx-usb-driver/dist/
!externals/xilinx-usb-driver/dist/xilinx-platform-cable-windows.zip
