# The cross-build image only needs its Dockerfile and toolchain file at image
# build time. The complete repository is bind-mounted at runtime by Compose.
**
!deploy/
!deploy/docker/
!deploy/docker/cross/
!deploy/docker/cross/windows/
!deploy/docker/cross/windows/alpine.Dockerfile
!deploy/docker/cross/windows/toolchain-mingw64.cmake

# Re-include the built XPCU driver archive so the optional
# `cross-with-driver` stage can bake it in (see alpine.Dockerfile).
!externals/xilinx-usb-driver/dist/xilinx-platform-cable-windows.zip
